Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Accumulated Map
      Enabled: true
      Topic:
        Value: /mapping/map
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Color Transformer: Intensity
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /mapping/path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
    - Class: rviz_default_plugins/Map
      Name: Projected Occupancy Grid
      Enabled: false
      Topic:
        Value: /mapping/map_2d
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 800
